# Expo inlines EXPO_PUBLIC_* variables at build time. Copy to `.env` and fill in.
#
# Both values are safe to ship in the app bundle. The anon key identifies the
# Supabase project and grants nothing on its own: every request to this app's
# backend is checked against the signed JWT, and every row is gated by
# PostgreSQL row level security behind that.
#
# What is NOT here, and must never be: the service role key, the database
# password, and the user's own password or data key.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<the project's anon/publishable key>
